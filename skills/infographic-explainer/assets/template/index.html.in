<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=1440,height=1080"><script src="assets/gsap.min.js"></script>
<style>
@font-face{font-family:'Kaiti SC';src:local('Kaiti SC'),local('KaiTi'),local('Noto Serif CJK SC')}
@font-face{font-family:'PingFang SC';src:local('PingFang SC'),local('Microsoft YaHei'),local('Noto Sans CJK SC')}
*{box-sizing:border-box}html,body{margin:0;width:1440px;height:1080px;overflow:hidden;background:#fffef9}body{font-family:'Kaiti SC',serif}#root{width:1440px;height:1080px;position:relative;overflow:hidden;background:#fffef9}.clip{position:absolute;inset:0}#scene{height:910px;overflow:hidden}#camera{width:1600px;height:1050px;transform-origin:0 0;position:absolute;left:0;top:0}svg.board{display:block;width:1600px;height:1050px;overflow:visible}text{fill:#252421}.small{font-size:25px;fill:#64615a}.body{font-size:31px}.cardtitle{font-size:39px}.gold{fill:#8c6c12}.outline{fill:none;stroke:#252421;stroke-width:3.3;stroke-linejoin:round}.mark{fill:none;stroke:#d92d20;stroke-width:8;stroke-linecap:round;stroke-linejoin:round}.subtitle{position:absolute;left:70px;right:70px;bottom:48px;height:76px;display:flex;align-items:center;justify-content:center;opacity:0;font-family:'PingFang SC',sans-serif;font-size:42px;font-weight:600;color:white;text-shadow:0 2px 3px #252421;z-index:9}.subtitle span{background:#252421;padding:13px 28px;border-radius:12px}#footerwash{position:absolute;left:0;right:0;bottom:0;height:170px;background:linear-gradient(transparent,#fffef9 85%);pointer-events:none}#progress{position:absolute;bottom:0;left:0;height:5px;width:1440px;background:#d92d20;transform-origin:left}#cursor{opacity:0}
</style></head><body>
<div id="root" data-composition-id="main" data-start="0" data-duration="{{DURATION}}" data-width="1440" data-height="1080" data-fps="30">
<!-- Camera viewport clips board content at y=910; offscreen SVG bounds can intersect the separate subtitle rail in the layout analyzer, but are not painted there. -->
<div id="scene" data-layout-allow-overlap data-layout-allow-occlusion class="clip" data-start="0" data-duration="{{DURATION}}" data-track-index="1" data-layout-allow-overflow>
<div id="camera" data-layout-allow-overflow>
<svg class="board" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1600 1050" role="img" aria-label="商业模式信息图" data-layout-allow-overflow>
<defs><marker id="arrow" viewBox="0 0 12 12" refX="10" refY="6" markerWidth="9" markerHeight="9" orient="auto-start-reverse"><path d="M2 2 L10 6 L2 10" fill="none" stroke="#64615a" stroke-width="1.5"/></marker></defs>
<g id="heading"><text x="78" y="102" font-size="66" style="fill:#b63c2f">2026 商业模式</text><text x="80" y="184" font-size="39">把现成 AI 能力做成可售卖系统</text><text x="80" y="256" font-size="29">不管在哪个城市，先找到真实的客户需求</text></g>
<g id="income"><path class="outline" d="M920 42 Q902 42 902 71 L905 228 Q906 249 937 250 L1486 247 Q1513 247 1512 219 L1509 71 Q1507 41 1478 41 Z"/><text x="950" y="142" font-size="69">7位数</text><text x="1172" y="138" font-size="65" fill="#64615a">→</text><text x="1270" y="142" font-size="69" class="gold">8位数</text><text x="1005" y="212" font-size="28" class="small">规模目标，仍需业务验证</text></g>
<g id="flow">
<path d="M98 348 Q76 348 77 378 L80 520 Q80 546 108 546 L306 545 Q332 544 333 518 L330 374 Q328 348 302 349 Z" fill="#ffed9e" stroke="#252421" stroke-width="3.3"/>
<text x="113" y="388" class="small" style="fill:#64615a">这门生意的核心</text><text x="116" y="450" font-size="54">AI广场</text><text x="111" y="501" font-size="26">把能力摆上摊位</text>
<g class="outline" marker-end="url(#arrow)" stroke="#64615a"><path d="M340 449 L388 449"/><path d="M636 449 L683 449"/><path d="M931 449 L978 449"/><path d="M1226 449 L1273 449"/></g>
<rect x="402" y="350" width="222" height="194" rx="30" fill="#fffef9" stroke="#252421" stroke-width="3.3" transform="rotate(-.4 513 447)"/>
<text x="437" y="402" class="cardtitle">卖工具箱</text><text x="430" y="452" class="small">按行业打包</text><text x="430" y="489" class="small">让客户直接用</text>
<rect x="697" y="350" width="222" height="194" rx="31" fill="#fffef9" stroke="#252421" stroke-width="3.3" transform="rotate(.5 808 447)"/>
<text x="730" y="402" class="cardtitle">行业定制</text><text x="725" y="452" class="small">围绕具体需求</text><text x="725" y="489" class="small">交付实际结果</text>
<rect x="992" y="350" width="222" height="194" rx="29" fill="#ffed9e" stroke="#252421" stroke-width="3.3" transform="rotate(-.3 1103 447)"/>
<text x="1025" y="402" class="cardtitle">持续收费</text><text x="1020" y="452" class="small">持续使用与维护</text><text x="1020" y="489" class="small">服务创造价值</text>
<rect x="1287" y="350" width="222" height="194" rx="30" fill="#fffef9" stroke="#252421" stroke-width="3.3"/>
<text x="1320" y="402" class="cardtitle">连锁复制</text><text x="1315" y="452" class="small">先跑通一处</text><text x="1315" y="489" class="small">再复制经验</text>
</g>
<g id="ribbon"><rect x="80" y="598" width="1430" height="74" rx="12" fill="#252421"/><text x="795" y="645" font-size="32" text-anchor="middle" style="fill:#fffef9">工具箱　 →　 行业定制　 →　 持续服务　 →　 规模复制</text></g>
<g id="recurring"><rect x="79" y="720" width="682" height="202" rx="31" fill="#fffef9" stroke="#252421" stroke-width="3.2"/><text x="111" y="764" class="small">系统跑起来之后</text><text x="111" y="826" font-size="41">第一个月，服务 100 个客户</text><text x="111" y="882" class="small">后续维护、支持和更新，才是长期关系</text><rect x="803" y="720" width="706" height="202" rx="32" fill="#ffed9e" stroke="#252421" stroke-width="3.2"/><text x="837" y="764" class="small">持续服务的前提</text><text x="837" y="826" font-size="43">客户持续使用</text><text x="837" y="881" class="body">有价值，才有机会持续收费</text></g>
<text x="80" y="998" class="small" style="font-size:23px">从一张图出发，把复杂的思路讲清楚。</text>
<g id="annotations"><path id="line1" class="mark" d="M380 200 Q455 207 530 201 T684 204"/><path id="line2" class="mark" d="M1270 157 Q1310 153 1360 161 T1467 159"/><path id="line3" class="mark" d="M728 414 Q771 420 812 415 T887 417"/><path id="line4" class="mark" d="M1023 414 Q1070 420 1115 415 T1180 417"/><path id="line5" class="mark" d="M838 839 Q945 846 1050 840 T1150 842"/>
<g id="cursor"><path d="M0 0 L0 31 L8 24 L15 39 L22 35 L15 21 L27 20 Z" fill="#fffef9" stroke="#252421" stroke-width="2.1"/></g></g>
</svg></div></div>

<!-- Captions and audio are built synchronously from story.js. -->
<div id="progress" data-layout-ignore></div>
</div>
<script src="story.js"></script>
<script src="runtime.js"></script></body></html>
