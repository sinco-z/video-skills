<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width={{WIDTH}},height={{HEIGHT}}"><script src="assets/gsap.min.js"></script>
<style>
@font-face{font-family:'Kaiti SC';src:local('Kaiti SC'),local('KaiTi'),local('Noto Serif CJK SC')}
@font-face{font-family:'PingFang SC';src:local('PingFang SC'),local('Microsoft YaHei'),local('Noto Sans CJK SC')}
*{box-sizing:border-box}html,body{margin:0;width:{{WIDTH}}px;height:{{HEIGHT}}px;overflow:hidden;background:#fffef9}body{font-family:'Kaiti SC',serif}#root{width:{{WIDTH}}px;height:{{HEIGHT}}px;position:relative;overflow:hidden;background:#fffef9}.clip{position:absolute;inset:0}#scene{height:{{VIEWPORT_HEIGHT}}px;overflow:hidden}#camera{width:{{BOARD_WIDTH}}px;height:{{BOARD_HEIGHT}}px;transform-origin:0 0;position:absolute;left:0;top:0}svg.board{display:block;width:{{BOARD_WIDTH}}px;height:{{BOARD_HEIGHT}}px;overflow:visible}text{fill:#252421}.small{font-size:25px;fill:#64615a}.body{font-size:31px}.cardtitle{font-size:39px}.gold{fill:#8c6c12}.outline{fill:none;stroke:#252421;stroke-width:3.3;stroke-linejoin:round}.mark{fill:none;stroke:#d92d20;stroke-width:8;stroke-linecap:round;stroke-linejoin:round}.subtitle{position:absolute;left:{{MARGIN}}px;right:{{MARGIN}}px;bottom:{{CAPTION_BOTTOM}}px;height:{{CAPTION_HEIGHT}}px;display:flex;align-items:center;justify-content:center;opacity:0;font-family:'PingFang SC',sans-serif;font-size:{{CAPTION_FONT_SIZE}}px;font-weight:600;color:white;text-shadow:0 2px 3px #252421;z-index:9}.subtitle span{background:#252421;padding:13px 28px;border-radius:12px;max-width:100%;text-align:center;line-height:1.3;overflow-wrap:anywhere}#footerwash{position:absolute;left:0;right:0;bottom:0;height:170px;background:linear-gradient(transparent,#fffef9 85%);pointer-events:none}#progress{position:absolute;bottom:0;left:0;height:5px;width:{{WIDTH}}px;background:#d92d20;transform-origin:left}#cursor{opacity:0}
</style></head><body>
<div id="root" data-composition-id="main" data-start="0" data-duration="{{DURATION}}" data-width="{{WIDTH}}" data-height="{{HEIGHT}}" data-fps="{{FPS}}">
<!-- Camera viewport clips board content at y={{VIEWPORT_HEIGHT}}; offscreen SVG bounds can intersect the separate subtitle rail in the layout analyzer, but are not painted there. -->
<div id="scene" data-layout-allow-overlap data-layout-allow-occlusion class="clip" data-start="0" data-duration="{{DURATION}}" data-track-index="1" data-layout-allow-overflow>
<div id="camera" data-layout-allow-overflow>
<svg class="board" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {{BOARD_WIDTH}} {{BOARD_HEIGHT}}" role="img" aria-label="{{BOARD_LABEL}}" data-layout-allow-overflow>
{{BOARD_CONTENT}}
<g id="annotations">{{ANNOTATION_PATHS}}
<g id="cursor"><path d="M0 0 L0 31 L8 24 L15 39 L22 35 L15 21 L27 20 Z" fill="#fffef9" stroke="#252421" stroke-width="2.1"/></g></g>
</svg></div></div>

<!-- Captions and audio are built synchronously from story.js. -->
<div id="progress" data-layout-ignore></div>
</div>
<script src="story.js"></script>
<script src="runtime.js"></script></body></html>
